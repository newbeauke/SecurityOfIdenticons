@model SecurityOfIdenticons.Models.ExperimentTrial

@{
    ViewData["Title"] = "Experiment";
    Layout = null; // No global layout is defined
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap & HTMX -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <style>
        /* Display Identicons at a more realistic small size without breaking DOM flow */
        .identicon-container-small .identicon-grid {
            border-width: 2px !important;
        }
        .identicon-container-small .cell {
            width: 25px !important;
            height: 25px !important;
        }
        
        .font-mono { font-family: monospace; }
        .tracking-tight { letter-spacing: -0.025em; }
    </style>
</head>
<body class="bg-light">

<div class="container py-3">
        <div class="mb-3 text-center">
            <a href="@Url.Action("Results", "Experiment")" class="btn btn-primary btn-sm">Go to Experiment Results</a>
            <a href="@Url.Action("Index", "Identicon")" class="btn btn-outline-secondary btn-sm ms-2">Go to Generator</a>
        </div>

    <header class="mb-4 text-center">
        <h2 class="fw-bold tracking-tight">Visual Confusion Experiment</h2>
        <p class="text-muted">Target Similarity Threshold: @Model.CurrentThreshold.ToString("P0")</p>
        <p class="mb-0 fw-bold @((ViewBag.Streak != null && ViewBag.Streak > 0) ? "text-success" : "text-muted")">Current Streak: @(ViewBag.Streak ?? 0)</p>
    </header>

    <section class="card mb-4 mx-auto" style="max-width: 900px;">
        <div class="card-body text-center p-5">
            <!-- Phase 1: Target -->
            <div id="target-phase">
                <h4>Memorize your Identicon (Target)</h4>
                <div class="my-5 identicon-container-small">
                    @await Html.PartialAsync("_Identicon", Model.Target)
                </div>
                <button id="btn-next" class="btn btn-primary mt-5">Ready (Hide Target)</button>
            </div>

            <!-- Distraction Phase -->
            <div id="distraction-phase" style="display: none;" class="my-5 py-5">
                <h4>What is 4 + 7?</h4>
                <p class="text-muted">Wait for it...</p>
            </div>

            <!-- Phase 2: Lineup -->
            <div id="lineup-phase" style="display: none;">
                <h4>Which one is your Target?</h4>

                <form hx-post="@Url.Action("SubmitGuess", "Experiment")" hx-target="body" hx-swap="outerHTML" class="mt-4">
                    <input type="hidden" name="trialId" value="@Model.TrialId" />
                    <input type="hidden" name="correctIndex" value="@Model.CorrectLineupIndex" />
                    <input type="hidden" name="threshold" value="@Model.CurrentThreshold.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                    <input type="hidden" name="streak" value="@(ViewBag.Streak ?? 0)" />

                    <input type="hidden" name="resolution" value="@Model.Parameters.Resolution" />
                    <input type="hidden" name="isSymmetric" value="@Model.Parameters.IsSymmetric.ToString()" />
                    <input type="hidden" name="colorCount" value="@Model.Parameters.ColorCount" />
                    <input type="hidden" name="saturation" value="@Model.Parameters.Saturation" />
                    <input type="hidden" name="lightness" value="@Model.Parameters.Lightness" />
                    <input type="hidden" name="minHueDistance" value="@Model.Parameters.MinHueDistance" />
                    <input type="hidden" name="hueSpacing" value="@Model.Parameters.HueSpacing" />

                    <div class="row justify-content-center gx-3">
                        @for (int i = 0; i < Model.Lineup.Count; i++)
                        {
                            <div class="col-auto text-center">
                                <h6 class="text-muted mb-2">Avatar @(i + 1)</h6>
                                <div class="mb-3 identicon-container-small">
                                    @await Html.PartialAsync("_Identicon", Model.Lineup[i])
                                </div>
                                <button type="submit" name="guessedIndex" value="@i" class="btn btn-outline-primary btn-sm w-100">Select @(i + 1)</button>
                            </div>
                        }
                    </div>

                    <div class="mt-5">
                        <button type="submit" name="guessedIndex" value="-1" class="btn btn-outline-secondary">None of these are the Target</button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

    <script>
        // Unbind any previous listener if HTMX swaps the body to avoid duplicate events
        if (window.expKeydownHandler) {
            document.removeEventListener('keydown', window.expKeydownHandler);
        }

        window.expKeydownHandler = function(e) {
            var targetPhase = document.getElementById('target-phase');
            var lineupPhase = document.getElementById('lineup-phase');
            var btnNext = document.getElementById('btn-next');
            
            if (targetPhase && targetPhase.style.display !== 'none') {
                if (e.code === 'Space') {
                    e.preventDefault();
                    btnNext.click();
                }
            } else if (lineupPhase && lineupPhase.style.display !== 'none') {
                var guess = -1;
                if (e.key >= '1' && e.key <= '5') {
                    guess = parseInt(e.key) - 1; // 0-indexed for the form
                } else if (e.key === '0') {
                    guess = -1;
                } else {
                    return; // not a relevant key
                }
                
                // Find the button with this value
                var btn = document.querySelector('button[name="guessedIndex"][value="' + guess + '"]');
                if (btn) {
                    btn.click();
                }
            }
        };

        document.addEventListener('keydown', window.expKeydownHandler);

        var btnNext = document.getElementById('btn-next');
        if (btnNext) {
            btnNext.addEventListener('click', function () {
                document.getElementById('target-phase').style.display = 'none';
                document.getElementById('distraction-phase').style.display = 'block';

                // Artificial delay (Cognitive masking / Distraction phase) before showing lineup
                setTimeout(() => {
                    document.getElementById('distraction-phase').style.display = 'none';
                    document.getElementById('lineup-phase').style.display = 'block';
                }, 2000); // 2 second delay
            });
        }
    </script>
</body>
</html>
