@using System.Text.Json
@model IEnumerable<SecurityOfIdenticons.Models.ExperimentResult>

@{
    ViewData["Title"] = "Experiment Results";
    Layout = null;
    var configs = ViewBag.Configs as List<SecurityOfIdenticons.IdenticonParameters>;
    string currentConfigFilter = ViewBag.CurrentConfigFilter as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap & HTMX -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .font-mono { font-family: monospace; }
        .tracking-tight { letter-spacing: -0.025em; }
    </style>
</head>
<body class="bg-light">

<div class="container py-3">
    <header class="mb-4 text-center">
        <div class="mb-3">
            <a href="@Url.Action("Index", "Identicon")" class="btn btn-outline-secondary btn-sm ms-2">Go to Generator</a>
        </div>

        <h2 class="fw-bold tracking-tight">Experiment Results</h2>
    </header>

    @if (Model.Any())
    {
        <section class="card mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold border-bottom pb-2 mb-3 tracking-tight">Analysis</h5>
                <div class="p-4 bg-light rounde">
                    <div class="row">
                        <div class="col-md-3 mb-3 mb-md-0">
                            <div class="text-muted small">Effective Entropy</div>
                            <div class="fw-bold fs-5" style="white-space: nowrap">@(((double)(ViewBag.RawEntropy ?? 0)).ToString("F1")) bits</div>
                            <div class="small text-muted">Search Space of @(((double)(ViewBag.SearchSpaceCount ?? 0)).ToString("N0"))</div>
                        </div>
                        <div class="col-md-3 mb-3 mb-md-0 border-start">
                            <div class="text-muted small">Estimated Confusion Threshold</div>
                            <div class="fw-bold fs-5" style="white-space: nowrap">@(((double)(ViewBag.GlobalThreshold ?? 0)).ToString("P1"))</div>
                            <div class="small text-muted">Average of the latest half of runs</div>
                        </div>
                        <div class="col-md-3 mb-3 mb-md-0 border-start">
                            <div class="text-muted small">Total Runs</div>
                            <div class="fw-bold fs-5" style="white-space: nowrap">@Model.Count()</div>
                            <div class="small text-muted">Total runs for this config</div>
                        </div>
                        <div class="col-md-3 mb-3 mb-md-0 border-start">
                            <div class="text-muted small">Visual Entropy (Experimental! More testing needed)</div>
                            <div class="fw-bold fs-5" style="white-space: nowrap">@(((double)(ViewBag.VisualEntropy ?? 0)).ToString("F1")) bits</div>
                            <div class="small text-muted">@(((double)(ViewBag.VisualSpaceCount ?? 0)).ToString("N0")) distinct visual options</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="card mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold border-bottom pb-2 mb-3 tracking-tight">Psychometric Curve</h5>
                <canvas id="psychometricChart" width="400" height="150"></canvas>
            </div>
        </section>

        <section class="card mb-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h5 class="fw-bold tracking-tight mb-0">List of Runs</h5>
                    <form method="get" action="@Url.Action("Results", "Experiment")" class="d-flex align-items-center gap-2">
                        <label for="configFilter" class="form-label small fw-semibold mb-0 text-nowrap">Filter by Settings:</label>
                        <select name="configFilter" id="configFilter" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                            <option value="all" selected="@(ViewBag.CurrentConfigFilter == "all")">All Settings</option>
                            @if (ViewBag.Configs != null)
                            {
                                foreach (var config in ViewBag.Configs)
                                {
                                    string configText = $"{config.Resolution}x{config.Resolution}, Sym: {config.IsSymmetric}, Colors: {config.ColorCount}, Sat: {config.Saturation}, Lgt: {config.Lightness}";
                                    if (config.ColorCount > 1)
                                    {
                                        configText += $", HueDist: {config.MinHueDistance}, HueSpc: {config.HueSpacing}";
                                    }
                                    
                                    string serialized = System.Text.Json.JsonSerializer.Serialize(config);
                                    <option value="@serialized" selected="@(ViewBag.CurrentConfigFilter == serialized)">@configText</option>
                                }
                            }
                        </select>
                    </form>
                </div>
                
                <div class="table-responsive rounded border">
                    <table class="table table-striped table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Time</th>
                                <th>Target Threshold</th>
                                <th>Result</th>
                                <th>Correct Identicon</th>
                                <th>Guess</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var result in Model.OrderByDescending(x => x.Timestamp))
                            {
                                <tr>
                                    <td class="ps-4">@result.Timestamp.ToLocalTime().ToString("MMM dd, HH:mm:ss")</td>
                                    <td>@result.Threshold.ToString("P0") </td>
                                    <td>
                                        @if (result.GuessedCorrectly)
                                        {
                                            <span class="badge bg-success px-2 py-1">Correct</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-2 py-1">Wrong</span>
                                        }
                                    </td>
                                    <td>@(result.CorrectIndex + 1)</td>
                                    <td>
                                        @if (result.GuessedIndex == -1)
                                        {
                                            <span>None of them</span>
                                        }
                                        else
                                        {
                                            @(result.GuessedIndex + 1)
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="text-center text-muted mt-5 py-5">
            <h4>No experimental results found yet.</h4>
            <p>Run the experiment to start collecting data.</p>
        </div>
    }

    <section class="card mb-4 border-danger">
        <div class="card-body p-4 text-center">
            <form method="post" action="@Url.Action("ClearResults", "Experiment")" onsubmit="return confirm('Are you sure you want to clear ALL experimental results? This cannot be undone.');">
                <button type="submit" class="btn btn-outline-danger btn-sm">Clear All Results</button>
            </form>
        </div>
    </section>
</div>

    @if (Model.Any())
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            var ctx = document.getElementById('psychometricChart').getContext('2d');
            var rawData = @Html.Raw(ViewBag.ChartData);

            var chart = new Chart(ctx, {
                type: 'line',
                data: {
                    datasets: [
                        {
                            label: 'Accuracy %',
                            data: rawData, // Uses x and y from rawData
                            borderColor: 'rgb(75, 192, 192)',
                            backgroundColor: 'rgba(75, 192, 192, 0.2)',
                            borderWidth: 2,
                            pointRadius: 4,
                            pointBackgroundColor: 'rgb(75, 192, 192)',
                            tension: 0.4, // Cubic interpolation for smooth curve
                            yAxisID: 'y'
                        },
                        {
                            label: 'Number of Runs',
                            data: rawData.map(function(d) { return { x: d.x, y: d.count }; }),
                            borderColor: 'rgb(153, 102, 255)',
                            backgroundColor: 'rgba(153, 102, 255, 0.2)',
                            borderWidth: 2,
                            borderDash: [5, 5], // Dashed line to distinguish
                            pointRadius: 4,
                            pointBackgroundColor: 'rgb(153, 102, 255)',
                            tension: 0.4,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    scales: {
                        x: {
                            type: 'linear',
                            title: {
                                display: true,
                                text: 'Similarity Threshold (%)',
                                font: { weight: 'bold' }
                            },
                            min: 50,
                            max: 100
                        },
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Correct Guesses (%)',
                                font: { weight: 'bold' }
                            },
                            min: 0,
                            max: 100
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Number of Runs',
                                font: { weight: 'bold' }
                            },
                            min: 0,
                            grid: {
                                drawOnChartArea: false // Avoid overlapping grid lines
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    if (context.datasetIndex === 0) {
                                        return `Accuracy: ${context.raw.y.toFixed(1)}% (from ${context.raw.count} trials)`;
                                    } else {
                                        return `Runs: ${context.raw.y}`;
                                    }
                                }
                            }
                        }
                    }
                }
            });
        </script>
    }
</body>
</html>
