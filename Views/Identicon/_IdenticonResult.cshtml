@model List<IdenticonResult>
@using SecurityOfIdenticons
@{
    var parameters = ViewBag.Parameters as IdenticonParameters;
    var firstResult = Model.FirstOrDefault();
}

<div class="card lab-card animate-fadeIn">
<div class="card-body p-4">
        @if (firstResult != null && !string.IsNullOrEmpty(firstResult.WarningMessage))
        {
            <div class="alert @(firstResult.WarningMessage.StartsWith("Warning") ? "alert-warning" : "alert-info") text-center mb-4 small fw-semibold">
                @firstResult.WarningMessage
            </div>
        }
    <div class="row mb-5">

        <!-- Identicons -->
        @foreach (var result in Model)
        {
            <div class="col-md-6 text-center mb-4 mb-md-0 position-relative">
                <!-- Download -->
                <div class="position-absolute top-0 end-0 mt-0 me-3">
                    @{
                        string svg = $"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 {result.Resolution * 40} {result.Resolution * 40}' width='400' height='400'>";
                        int count = 0;
                        foreach(var colorIndex in result.Grid)
                        {
                            int x = (count % result.Resolution) * 40;
                            int y = (count / result.Resolution) * 40;
                            string bgColor = colorIndex == 0 ? "#dee2e6" : (result.Colors != null && result.Colors.Count > 0 && colorIndex <= result.Colors.Count) ? result.Colors[colorIndex - 1] : "black";
                            svg += $"<rect x='{x}' y='{y}' width='40' height='40' fill='{bgColor}' />";
                            count++;
                        }
                        svg += "</svg>";
                        string svgBase64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg));
                        string dataUri = $"data:image/svg+xml;base64,{svgBase64}";
                    }
                    <a href="@dataUri" download="identicon.svg" class="btn btn-sm btn-light border text-secondary" title="Download SVG">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-download" viewBox="0 0 16 16">
                            <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
                            <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                        </svg>
                    </a>
                </div>
                <h6 class="fw-bold mb-3">@result.Identifier</h6>
                <div style="display: grid; grid-template-columns: repeat(@result.Resolution, 1fr); margin: 0 auto; width: fit-content;">
                    @foreach (var colorIndex in result.Grid)
                    {
                        string bgColor;
                        if (colorIndex == 0)
                        {
                            bgColor = "#dee2e6";
                        }
                        else if (result.Colors != null && result.Colors.Count > 0 && colorIndex <= result.Colors.Count)
                        {
                            bgColor = result.Colors[colorIndex - 1];
                        }
                        else
                        {
                            bgColor = "black";
                        }
                        <div style="width: 40px; height: 40px; background-color: @bgColor;"></div>
                    }
                </div>
                <div class="mt-2 small text-muted font-mono uppercase">Resolution: @(result.Resolution)x@(result.Resolution)</div>
                @if (result.Colors != null && result.Colors.Count > 0)
                {
                    <div class="mt-2 d-flex justify-content-center gap-2">
                        @for (int i = 0; i < result.Colors.Count; i++)
                        {
                            <div class="p-1 text-white" style="height: 30px; background-color: @result.Colors[i]; border-radius: 4px;">@result.Colors[i]</div>
                        }
                    </div>
                }

                <div class="mt-4 text-start font-mono small bg-light p-2 rounded" style="word-break: break-all;">
                    <div class="text-muted text-uppercase mb-1" style="font-size: 0.7rem;">SHA-256 hash</div>
                    <div class="mb-2">@result.HashHex</div>

                    <div class="text-muted text-uppercase mb-1" style="font-size: 0.7rem;">Binary Breakdown</div>
                    <div class="mb-2" style="font-size: 0.8rem;">
                        @{
                            int currentBit = 0;
                            var sortedRoles = result.BitRoles.OrderBy(r => r.StartBit).ToList();
                        }
                        @foreach (var role in sortedRoles)
                        {
                            @if (role.StartBit > currentBit && currentBit < result.HashBinary.Length)
                            {
                                int len = Math.Min(role.StartBit - currentBit, result.HashBinary.Length - currentBit);
                                <span class="text-muted opacity-50">@result.HashBinary.Substring(currentBit, len)</span>
                            }
                            @if (role.StartBit < result.HashBinary.Length)
                            {
                                int len = Math.Min(role.BitLength, result.HashBinary.Length - role.StartBit);
                                <mark class="text-white" style="background-color: @role.ColorHex; border-radius: 3px; padding: 0px 2px">@result.HashBinary.Substring(role.StartBit, len)</mark>
                                currentBit = role.StartBit + len;
                            }
                        }
                        @if (currentBit < result.HashBinary.Length)
                        {
                            <span class="text-muted opacity-50">@result.HashBinary.Substring(currentBit)</span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-2" style="font-size: 0.75rem;">
                        @foreach (var role in sortedRoles)
                        {
                            <span class="badge" style="background-color: @role.ColorHex;">@role.RoleName</span>
                        }
                        <span class="badge border text-muted opacity-75" style="background: transparent;">Unused</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Generator metrics -->
    @if (firstResult != null)
    {
        <div class="row mb-5">
            <div class="col-12">
                <h5 class="fw-bold border-bottom pb-2 mb-3 tracking-tight">Generator Metrics</h5>
                <div class="row g-3 font-mono">
                    <div class="col-md-3 col-6">
                        <div class="text-muted small uppercase">Total Entropy</div>
                        <div class="fw-bold">~@firstResult.EntropyBits.ToString("F1") bits</div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="text-muted small uppercase">Search Space</div>
                        <div class="fw-bold">@(Math.Pow(2, firstResult.EntropyBits).ToString("N0"))</div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="text-muted small uppercase">Color Mode</div>
                        <div class="fw-bold">@(parameters.ColorCount == 0 ? "None" : parameters.ColorCount + " color" + (parameters.ColorCount > 1 ? "s" : ""))</div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="text-muted small uppercase">Grid Mode</div>
                        <div class="fw-bold">@(parameters.IsSymmetric ? "Symmetric" : "Asymmetric")</div>
                    </div>
                </div>

                <!-- Entropy breakdown -->
                <div class="mt-4 p-3 bg-light rounded">
                    <h6 class="fw-bold small mb-2">Entropy breakdown</h6>
                    <div class="small font-mono">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Pattern (@firstResult.Resolution×@firstResult.Resolution @(parameters.IsSymmetric ? "symmetric" : "asymmetric")):</span>
                            <span class="fw-bold">@firstResult.PatternEntropyBits bits</span>
                        </div>
                        @if (parameters.ColorCount > 0)
                        {
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Palette (@firstResult.PaletteOptions options, @(parameters.MinHueDistance)° apart):</span>
                                <span class="fw-bold">+@firstResult.PaletteEntropyBits.ToString("F1") bits</span>
                            </div>
                        }
                        @if (parameters.ColorCount > 1)
                        {
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Color assignment (~@(firstResult.PatternEntropyBits / 2.0) avg active cells x log₂(@parameters.ColorCount) bits/cell):</span>
                                <span class="fw-bold">+@firstResult.ColorEntropyBits.ToString("F1") bits</span>
                            </div>
                        }
                        <div class="border-top border-secondary mt-2 pt-2 d-flex justify-content-between">
                            <span class="fw-bold">Total:</span>
                            <span class="fw-bold">~@firstResult.EntropyBits.ToString("F1") bits</span>
                        </div>
                    </div>
                </div>

                <div class="mt-3 p-3 bg-light rounded small italic text-secondary">
                    A 1-bit change in the input hash shifts the @firstResult.Resolution-grid structure by approximately @((100.0 / firstResult.EntropyBits).ToString("F1"))%
                </div>
            </div>
        </div>
    }

    <!-- Comparison metrics -->
    @if (Model.Count >= 2)
    {
        // 1. Hash Hamming Distance
        int hammingDistance = 0;
        string bin1 = Model[0].HashBinary;
        string bin2 = Model[1].HashBinary;
        int maxBits = 0;
        if (!string.IsNullOrEmpty(bin1) && !string.IsNullOrEmpty(bin2))
        {
            int len = Math.Min(bin1.Length, bin2.Length);
            maxBits = Math.Max(bin1.Length, bin2.Length);
            for (int i = 0; i < len; i++)
            {
                if (bin1[i] != bin2[i])
                {
                    hammingDistance++;
                }
            }
            hammingDistance += Math.Abs(bin1.Length - bin2.Length);
        }

        // 2. Grid Visual Differences
        int totalCells = Model[0].Grid.Length;
        int shapeDiff = 0;
        int exactDiff = 0;

        Func<IdenticonResult, int, string> getCellColor = (res, idx) =>
        {
            int cIdx = res.Grid[idx];
            if (cIdx == 0) return "bg";
            if (res.Colors != null && res.Colors.Count > 0 && cIdx <= res.Colors.Count) return res.Colors[cIdx - 1];
            return "black";
        };

        if (Model[0].Grid != null && Model[1].Grid != null && Model[0].Grid.Length == Model[1].Grid.Length)
        {
            for (int i = 0; i < totalCells; i++)
            {
                bool active1 = Model[0].Grid[i] > 0;
                bool active2 = Model[1].Grid[i] > 0;

                if (active1 != active2) shapeDiff++;

                string c1 = getCellColor(Model[0], i);
                string c2 = getCellColor(Model[1], i);
                if (c1 != c2) exactDiff++;
            }
        }

        <div class="row">
            <div class="col-12">
                <h5 class="fw-bold border-bottom pb-2 mb-3 tracking-tight">Comparison Metrics</h5>
                <div class="p-4 bg-light rounded font-mono">
                    <div class="row">
                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="text-muted small text-uppercase">Hamming Distance (Hash)</div>
                            <div class="fw-bold fs-5">@hammingDistance / @maxBits bits</div>
                            <div class="small text-muted">@((maxBits > 0 ? (hammingDistance / (double)maxBits * 100) : 0).ToString("F1"))% difference in raw hash bits</div>
                        </div>
                        <div class="col-md-4 mb-3 mb-md-0 border-start">
                            <div class="text-muted small text-uppercase">Shape Difference (Grid)</div>
                            <div class="fw-bold fs-5">@shapeDiff / @totalCells cells</div>
                            <div class="small text-muted">@((totalCells > 0 ? (shapeDiff / (double)totalCells * 100) : 0).ToString("F1"))% difference in active shape cells</div>
                        </div>
                        <div class="col-md-4 border-start">
                            <div class="text-muted small text-uppercase">Exact State (Grid + Color)</div>
                            <div class="fw-bold fs-5">@exactDiff / @totalCells cells</div>
                            <div class="small text-muted">@((totalCells > 0 ? (exactDiff / (double)totalCells * 100) : 0).ToString("F1"))% differences in exact cell color assignment</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
</div>